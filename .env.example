LOG_LEVEL=warn
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
CACHE_TTL_SECONDS=21600
STALE_TTL_SECONDS=604800
EMPTY_CACHE_TTL_SECONDS=60
HTTP_TIMEOUT_MS=5000

# Comma-separated origins. Use * only for public read-only APIs.
CORS_ORIGINS=*

# Comma-separated provider names in priority order.
# Single provider:  PROVIDER_ORDER=google-translate
# With fallback:    PROVIDER_ORDER=google-translate,google-dictionary-extension
PROVIDER_ORDER=google-translate,google-dictionary-extension

# Rate limiting for /translate/ (per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Set to false to disable JWT authentication entirely.
AUTH_ENABLED=true

# Secret used to verify JWT tokens (must match the secret of your JWT issuer, e.g. Strapi's JWT_SECRET).
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
